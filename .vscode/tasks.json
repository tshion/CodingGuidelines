{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "add-guideline",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "scripts/add-guideline.cs",
                "${input:category}",
                "${input:filename}"
            ]
        },
        {
            "label": "create-index",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "scripts/create-index.cs"
            ]
        },
        {
            "label": "sync-config",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "scripts/sync-config.cs"
            ]
        }
    ],
    "inputs": [
        {
            "id": "category",
            "type": "promptString",
            "description": "カテゴリー名"
        },
        {
            "id": "filename",
            "type": "promptString",
            "description": "ファイル名"
        }
    ]
}